{
  "name": "skills",
  "private": true,
  "type": "module",
  "version": "1.2.0",
  "description": "Portable Agent Skills for AI-assisted engineering",
  "scripts": {
    "validate": "node --experimental-strip-types scripts/validate-skills.ts && npm run validate:resources && npm run validate:evals && npm run validate:privacy",
    "validate:resources": "node --experimental-strip-types scripts/validate-resources.ts",
    "validate:evals": "node --experimental-strip-types scripts/validate-evals.ts",
    "validate:privacy": "node --experimental-strip-types scripts/audit-privacy.ts",
    "catalog": "node --experimental-strip-types scripts/generate-catalog.ts",
    "catalog:opencode": "node --experimental-strip-types scripts/generate-opencode-catalog.ts",
    "skills:list": "npx --yes skills@latest add . --list"
  },
  "engines": { "node": ">=22" }
}
